# Copy to .env (git-ignored) for local development, or inject these via
# your platform's secrets manager in every other environment. Never commit
# real values.

SPRING_PROFILES_ACTIVE=dev

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/visionselect
DB_USERNAME=visionselect
DB_PASSWORD=change_me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Server ---
SERVER_PORT=8080

# --- CORS (comma-separated origins, no wildcard) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT (security-contract.md) ---
# Not read by any code yet - Phase 2B ships the config shape only.
JWT_SECRET=change_me_at_least_256_bits_for_hs256
JWT_ACCESS_EXPIRATION_MINUTES=45
JWT_REFRESH_EXPIRATION_DAYS=21

# --- Internal AI-service auth (security-contract.md, layer 1 of 2) ---
# Not read by any code yet.
INTERNAL_SERVICE_TOKEN=change_me

# --- Video upload (storage-contract.md) ---
VIDEO_UPLOAD_URL_TTL_MINUTES=15

# StorageProvider selection. Only "local" is implemented as of this phase;
# "s3" / "gcs" are documented future values, not yet backed by real beans.
STORAGE_PROVIDER=local
# LocalStorageProvider only - dev/demo stand-in for real cloud storage.
STORAGE_LOCAL_BASE_DIRECTORY=./data/local-storage
STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8080
STORAGE_LOCAL_UPLOAD_GRANT_TTL_SECONDS=900
