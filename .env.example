# Copy this file to .env.local for local development.
# NEVER add real API keys, database credentials, JWT secrets, or any backend secrets here.
# VITE_* variables are embedded in the browser bundle and are visible to all users.

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Point this at your running Spring Boot backend.
# Local dev default (backend must NOT use port 8080 — use 8081 to avoid conflict):
VITE_API_BASE_URL=http://localhost:8081
